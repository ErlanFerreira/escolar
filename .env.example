SECRET_KEY=change-me-to-a-random-secret-key
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
ALLOWED_HOSTS=127.0.0.1,localhost

# Só necessário em produção (config.settings.prod) — ex: gestao-escolar.onrender.com
# CSRF_TRUSTED_ORIGINS precisa do esquema: https://gestao-escolar.onrender.com
# ALLOWED_HOSTS=gestao-escolar.onrender.com
# CSRF_TRUSTED_ORIGINS=https://gestao-escolar.onrender.com

# E-mail em produção (Brevo, por API — o Render gratuito bloqueia SMTP).
# DEFAULT_FROM_EMAIL precisa ser um remetente verificado no Brevo.
# BREVO_API_KEY=xkeysib-...
# DEFAULT_FROM_EMAIL=Gestão Escolar <seu-remetente-verificado@exemplo.com>
